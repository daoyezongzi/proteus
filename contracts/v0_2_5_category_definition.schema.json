{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v0_2_5_category_definition.schema.json",
  "title": "Proteus V0.2.5 Category Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "category_id",
    "group",
    "label_zh",
    "label_en",
    "display_order",
    "material_family",
    "identity_profile",
    "part_type",
    "aliases",
    "discovery",
    "supply",
    "required_capabilities",
    "risk",
    "examples"
  ],
  "properties": {
    "schema_version": {"const": "0.2.5"},
    "category_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "label_zh", "label_en", "display_order"],
      "properties": {
        "group_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "label_zh": {"type": "string", "minLength": 1, "maxLength": 80},
        "label_en": {"type": "string", "minLength": 1, "maxLength": 120},
        "display_order": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "label_zh": {"type": "string", "minLength": 1, "maxLength": 120},
    "label_en": {"type": "string", "minLength": 1, "maxLength": 160},
    "display_order": {"type": "integer", "minimum": 0, "maximum": 10000},
    "material_family": {
      "enum": ["CABLE", "PLASTIC", "LOW_LIABILITY_METAL", "OTHER"]
    },
    "identity_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    },
    "part_type": {"type": "string", "minLength": 3, "maxLength": 160},
    "aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2, "maxLength": 160}
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ebay_category_id", "queries"],
      "properties": {
        "ebay_category_id": {"type": "string", "pattern": "^[0-9]+$"},
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 200}
        }
      }
    },
    "supply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "aliases"],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"}
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"enum": ["LOW", "REVIEW", "HIGH"]},
        "rationale": {"type": "string", "minLength": 3, "maxLength": 1000}
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_titles", "negative_titles"],
      "properties": {
        "positive_titles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 500}
        },
        "negative_titles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 500}
        }
      }
    },
    "notes": {"type": "string", "maxLength": 2000}
  }
}
